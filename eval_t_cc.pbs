#!/bin/bash
#PBS -N eval_t_cc_e30
#PBS -P personal-kenneth0
#PBS -l select=1:ngpus=1:ncpus=8:mem=32gb
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -o /scratch/users/ntu/kenneth0/FYP-SmartObjectCounter/logs/
#PBS -e /scratch/users/ntu/kenneth0/FYP-SmartObjectCounter/logs/

REPO=/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter
cd "$REPO" || exit 1

module purge
module load pytorch/2.6.0-py3-cu11.8

export PYTHONPATH="$REPO:$PYTHONPATH"

python3 -u scripts/eval_t_cc.py \
  --data_root ./data/RGBT-CC-CVPR2021 \
  --ckpt outputs/t_cc_e30/best_t.pth \
  --split val \