#!/bin/bash
#PBS -N train_t_e30
#PBS -P personal-kenneth0
#PBS -l select=1:ngpus=1:ncpus=16:mem=110gb
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/kenneth0/FYP-SmartObjectCounter/logs/${PBS_JOBNAME}.o${PBS_JOBID}
#PBS -e /scratch/users/ntu/kenneth0/FYP-SmartObjectCounter/logs/${PBS_JOBNAME}.e${PBS_JOBID}

REPO=/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter
cd "$REPO" || exit 1

module purge
module load pytorch/2.6.0-py3-cu11.8

export PYTHONPATH="$REPO:$PYTHONPATH"

python3 -u scripts/train_rgbt.py \
  --mode t \
  --data_root ./data/RGBT-CC-CVPR2021 \
  --epochs 30 \
  --batch_size 1 \
  --lr 1e-5 \
  --save_dir outputs/t_e30