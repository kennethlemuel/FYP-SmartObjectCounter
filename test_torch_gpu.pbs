#!/bin/bash
#PBS -N test_torch_gpu
#PBS -P personal-kenneth0
#PBS -l select=1:ngpus=1
#PBS -l walltime=00:05:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1
module purge
module load pytorch/2.6.0-py3-cu11.8

python -u -c "import torch; print('torch', torch.__version__); print('cuda', torch.cuda.is_available()); print('device_count', torch.cuda.device_count())"

