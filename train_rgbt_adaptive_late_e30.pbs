#!/bin/bash
#PBS -N train_rgbt_adaptive_late_e30
#PBS -P personal-kenneth0
#PBS -l select=1:ngpus=1:ncpus=16:mem=110gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/kenneth0/FYP-SmartObjectCounter/logs/
#PBS -e /scratch/users/ntu/kenneth0/FYP-SmartObjectCounter/logs/

REPO=/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter
cd "$REPO" || exit 1

module purge
module load pytorch/2.6.0-py3-cu11.8

export PYTHONPATH="$REPO:$PYTHONPATH"

python3 -u scripts/train_rgbt.py \
  --mode adaptive_late \
  --data_root ./data/RGBT-CC-CVPR2021 \
  --epochs 30 \
  --batch_size 1 \
  --lr 1e-5 \
  --optimizer adam \
  --weight_decay 1e-4 \
  --crop_size 224 \
  --flip_prob 0.5 \
  --scheduler none \
  --img_h 768 \
  --img_w 1024 \
  --sigma 15.0 \
  --num_workers 4 \
  --amp \
  --save_dir outputs/rgbt_adaptive_late_e30_bs1_crop224