#!/bin/bash
#PBS -N train_rgbt_adaptive_late_e100_sanity
#PBS -P personal-kenneth0
#PBS -l select=1:ngpus=1:ncpus=16:mem=110gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

REPO=/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter
LOG_DIR="$REPO/logs"
mkdir -p "$LOG_DIR"

cd "$REPO" || exit 1

: "${PBS_JOBID:=manual}"
: "${PBS_JOBNAME:=train_rgbt_adaptive_late_e100_sanity}"

TS=$(date +%Y%m%d_%H%M%S)
LOG_FILE="$LOG_DIR/${PBS_JOBNAME}_${PBS_JOBID}_${TS}.log"
exec > "$LOG_FILE" 2>&1

echo "[log] $LOG_FILE"
echo "[job] name=$PBS_JOBNAME id=$PBS_JOBID host=$(hostname) time=$(date)"

module purge
module load pytorch/2.6.0-py3-cu11.8

export PYTHONUNBUFFERED=1
export PYTHONPATH="$REPO:$PYTHONPATH"

EPOCHS=100

python -u scripts/train_rgbt.py \
  --mode adaptive_late \
  --data_root ./data/RGBT-CC-CVPR2021 \
  --split_train train \
  --split_val val \
  --seed 42 \
  --epochs ${EPOCHS} \
  --batch_size 1 \
  --grad_accum 1 \
  --lr 1e-5 \
  --optimizer adam \
  --weight_decay 1e-4 \
  --crop_size 224 \
  --flip_prob 0.5 \
  --scheduler none \
  --img_h 768 \
  --img_w 1024 \
  --sigma 15.0 \
  --out_stride 8 \
  --num_workers 4 \
  --amp \
  --clip_grad 1.0 \
  --save_dir outputs/rgbt_adaptive_late_e100_sanity
