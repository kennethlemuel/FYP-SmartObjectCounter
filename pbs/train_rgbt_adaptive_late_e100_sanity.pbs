#!/bin/bash
#PBS -N train_rgbt_adaptive_late_e100_sanity
#PBS -P personal-kenneth0
#PBS -l select=1:ngpus=1:ncpus=16:mem=110gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

REPO="/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter"
LOG_DIR="${REPO}/logs"

: "${PBS_JOBID:=manual}"
: "${PBS_JOBNAME:=train_rgbt_adaptive_late_e100_sanity}"

TS="$(date +%Y%m%d_%H%M%S)"
LOG_FILE="${LOG_DIR}/${PBS_JOBNAME}_${PBS_JOBID}_${TS}.log"
OUT_DIR="${REPO}/outputs/rgbt_adaptive_late_e100_sanity/${PBS_JOBID}_${TS}"

mkdir -p "${LOG_DIR}" "$(dirname "${OUT_DIR}")"
cd "${REPO}"

exec > "${LOG_FILE}" 2>&1
echo "[log] ${LOG_FILE}"
echo "[job] name=${PBS_JOBNAME} id=${PBS_JOBID} host=$(hostname) time=$(date)"

module purge
module load pytorch/2.6.0-py3-cu11.8

export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO}:${PYTHONPATH}"

EPOCHS=100
SEED=42

python3 -u scripts/train_rgbt.py \
  --mode adaptive_late \
  --data_root "${REPO}/data/RGBT-CC-CVPR2021" \
  --out_dir "${OUT_DIR}" \
  --seed "${SEED}" \
  --epochs "${EPOCHS}" \
  --batch_size 1 \
  --workers 4 \
  --lr 1e-5 \
  --gate_lr 1e-5 \
  --weight_decay 1e-4 \
  --crop_size 224 \
  --sigma 15.0 \
  --down 8 \
  --amp \
  --grad_accum 1 \
  --clip_grad 1.0 \
  --freeze_backbones_epochs 5
