#!/bin/bash
#PBS -N train_rgbt_adaptive_fpn_e100_sanity
#PBS -P personal-kenneth0
#PBS -l select=1:ngpus=1:ncpus=16:mem=110gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail
umask 0022

REPO_DEFAULT="/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter"
REPO="${REPO_DEFAULT}"
if [ -n "${PBS_O_WORKDIR:-}" ] && [ -f "${PBS_O_WORKDIR}/scripts/train_rgbt_adaptive_fpn.py" ]; then
  REPO="${PBS_O_WORKDIR}"
fi

LOG_DIR="${REPO}/logs"
DATA_ROOT="${REPO}/data/RGBT-CC-CVPR2021"

: "${PBS_JOBID:=manual}"
: "${PBS_JOBNAME:=train_rgbt_adaptive_fpn_e100_sanity}"

TS="$(date +%Y%m%d_%H%M%S)"
LOG_FILE="${LOG_DIR}/${PBS_JOBNAME}_${PBS_JOBID}_${TS}.log"
OUT_DIR="${REPO}/outputs/${PBS_JOBNAME}/${PBS_JOBID}_${TS}"

mkdir -p "${LOG_DIR}" "${OUT_DIR}"
cd "${REPO}"

exec > "${LOG_FILE}" 2>&1
echo "[log] ${LOG_FILE}"
echo "[job] name=${PBS_JOBNAME} id=${PBS_JOBID} host=$(hostname) time=$(date)"

module purge
module load pytorch/2.6.0-py3-cu11.8

python3 - <<'PY'
import torch
print("torch", torch.__version__, "cuda", torch.cuda.is_available())
PY

export CUBLAS_WORKSPACE_CONFIG=:4096:8
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO}:${PYTHONPATH:-}"

EPOCHS=20
BATCH_SIZE=1
WORKERS=4
SEED=0
LR=1e-5
MAX_LR=3e-5
WEIGHT_DECAY=1e-4
CROP_SIZE=224
SIGMA=15.0
DOWN=4
LAMBDA_CNT=1e-2
MDROP_PROB=0.0
FREEZE_EPOCHS=5
EMA_DECAY=0.999

# Auto-pick latest RGB/T checkpoints for warm-start (if available).
mapfile -t WARM < <(python3 - <<'PY'
import os
import glob

root = os.environ.get("REPO", "")
def newest(pattern: str) -> str:
    paths = glob.glob(pattern)
    if not paths:
        return ""
    paths.sort(key=lambda p: os.path.getmtime(p), reverse=True)
    return paths[0]

print(newest(os.path.join(root, "outputs", "train_rgb_*", "*", "best.pth")))
print(newest(os.path.join(root, "outputs", "train_t_*", "*", "best.pth")))
PY
)
LATEST_RGB_CKPT="${RGB_WARM_CKPT:-${WARM[0]:-}}"
LATEST_T_CKPT="${T_WARM_CKPT:-${WARM[1]:-}}"

EXTRA_ARGS=()
if [ -n "${LATEST_RGB_CKPT}" ]; then
  echo "[init] warm-start rgb = ${LATEST_RGB_CKPT}"
  EXTRA_ARGS+=(--init_rgb_ckpt "${LATEST_RGB_CKPT}")
else
  echo "[init] warm-start rgb = NONE"
fi
if [ -n "${LATEST_T_CKPT}" ]; then
  echo "[init] warm-start t = ${LATEST_T_CKPT}"
  EXTRA_ARGS+=(--init_t_ckpt "${LATEST_T_CKPT}")
else
  echo "[init] warm-start t = NONE"
fi

python3 -u scripts/train_rgbt_adaptive_fpn.py \
  --data_root "${DATA_ROOT}" \
  --out_dir "${OUT_DIR}" \
  --epochs "${EPOCHS}" \
  --batch_size "${BATCH_SIZE}" \
  --workers "${WORKERS}" \
  --seed "${SEED}" \
  --lr "${LR}" \
  --weight_decay "${WEIGHT_DECAY}" \
  --use_onecycle \
  --max_lr "${MAX_LR}" \
  --crop_size "${CROP_SIZE}" \
  --sigma "${SIGMA}" \
  --down "${DOWN}" \
  --lambda_cnt "${LAMBDA_CNT}" \
  --modality_dropout \
  --mdrop_prob "${MDROP_PROB}" \
  --freeze_backbones_epochs "${FREEZE_EPOCHS}" \
  --ema \
  --ema_decay "${EMA_DECAY}" \
  --clip_grad 1.0 \
  --deterministic \
  --val_fullres \
  --val_img_h 768 \
  --val_img_w 1024 \
  "${EXTRA_ARGS[@]}"
