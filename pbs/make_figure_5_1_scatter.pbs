#!/bin/bash
#PBS -N make_figure_5_1_scatter
#PBS -P personal-kenneth0
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

REPO=/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter
LOG_DIR="${REPO}/logs/report_figures"
OUT_DIR="${REPO}/outputs/report_figures/figure_5_1"
mkdir -p "${LOG_DIR}" "${OUT_DIR}"
cd "${REPO}" || exit 1

TS=$(date +%Y%m%d_%H%M%S)
LOG_FILE="${LOG_DIR}/${PBS_JOBNAME}_${PBS_JOBID}_${TS}.log"
exec > "${LOG_FILE}" 2>&1
echo "[log] ${LOG_FILE}"

module purge
module load pytorch/2.6.0-py3-cu11.8

export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO}:${PYTHONPATH:-}"
export MPLCONFIGDIR="${OUT_DIR}/.mplconfig"
mkdir -p "${MPLCONFIGDIR}"

python3 -u scripts/make_figure_5_1_scatter.py \
  --out_dir "${OUT_DIR}"
