#!/bin/bash
#PBS -N train_rgbt_adaptive_late_e100
#PBS -P personal-kenneth0
#PBS -l select=1:ngpus=1:ncpus=16:mem=110gb
#PBS -l walltime=12:00:00
#PBS -j oe

REPO=/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter
cd "$REPO" || exit 1

LOGDIR=/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter/logs
mkdir -p "$LOGDIR"
JOBTAG="${PBS_JOBID:-$(date +%Y%m%d_%H%M%S)}"

module purge
module load pytorch/2.6.0-py3-cu11.8

export PYTHONPATH="$REPO:$PYTHONPATH"

python -u scripts/train_rgbt.py \
  --mode adaptive_late \
  --data_root ./data/RGBT-CC-CVPR2021 \
  --split_train train \
  --split_val val \
  --epochs 100 \
  --batch_size 1 \
  --grad_accum 1 \
  --lr 1e-5 \
  --optimizer adam \
  --weight_decay 1e-4 \
  --crop_size 224 \
  --flip_prob 0.5 \
  --scheduler none \
  --img_h 768 \
  --img_w 1024 \
  --sigma 15.0 \
  --out_stride 8 \
  --num_workers 4 \
  --amp \
  --clip_grad 1.0 \
  --pair_delta 1 \
  --normalize_temp_loss \
  --aux_warmup_epochs 10 \
  --illum_tau 0.35 \
  --count_loss_beta 1.0 \
  --ema_decay 0.0 \
  --save_dir outputs/rgbt_adaptive_late_e100_count_ema \
  > "${LOGDIR}/train_rgbt_adaptive_late_e100_count_ema_${JOBTAG}.out" \
  2> "${LOGDIR}/train_rgbt_adaptive_late_e100_count_ema_${JOBTAG}.err"
