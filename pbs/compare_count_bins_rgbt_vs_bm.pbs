#!/bin/bash
#PBS -N compare_count_bins_rgbt_vs_bm
#PBS -P personal-kenneth0
#PBS -l select=1:ngpus=1:ncpus=16:mem=70gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
umask 0022

REPO=/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter
LOG_DIR="${REPO}/logs/compare_count_bins"
OUT_ROOT="${REPO}/outputs/compare_count_bins"
mkdir -p "${LOG_DIR}" "${OUT_ROOT}"
cd "${REPO}" || exit 1

TS=$(date +%Y%m%d_%H%M%S)
LOG_FILE="${LOG_DIR}/${PBS_JOBNAME}_${PBS_JOBID}_${TS}.log"
OUT_DIR="${OUT_ROOT}/${PBS_JOBID}_${TS}"
exec > "${LOG_FILE}" 2>&1

echo "[log] ${LOG_FILE}"
echo "[out] ${OUT_DIR}"
echo "[job] ${PBS_JOBNAME} ${PBS_JOBID} host=$(hostname) time=$(date)"

module purge
module load pytorch/2.6.0-py3-cu11.8

export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO}:${PYTHONPATH:-}"

DATA_ROOT="${REPO}/data/RGBT-CC-CVPR2021"
THIRD_PARTY_ROOT="${REPO}/third_party/Broker-Modality-Crowd-Counting"
VGG19_LOCAL="${REPO}/weights/weights_broker_modality/vgg19-dcbb9e9d.pth"
BM_CKPT="${BM_CKPT:-${REPO}/weights/weights_broker_modality/released_finetuned_model.ckpt}"
STUDENT_CKPT="${STUDENT_CKPT:-}"

if [ -z "${STUDENT_CKPT}" ]; then
  STUDENT_CKPT="$(ls -1t "${REPO}"/outputs/train_rgbt_adaptive_fpn_lite_cal*/*/best.pth 2>/dev/null | head -n 1 || true)"
fi

echo "[student_ckpt] ${STUDENT_CKPT}"
echo "[bm_ckpt] ${BM_CKPT}"

test -f "${STUDENT_CKPT}"
test -f "${BM_CKPT}"
test -f "${VGG19_LOCAL}"
test -d "${DATA_ROOT}"
test -d "${THIRD_PARTY_ROOT}"

python3 -u scripts/compare_count_bins_rgbt_vs_bm.py \
  --data_root "${DATA_ROOT}" \
  --split test \
  --student_mode adaptive_fpn_lite_cal \
  --student_ckpt "${STUDENT_CKPT}" \
  --third_party_root "${THIRD_PARTY_ROOT}" \
  --bm_ckpt "${BM_CKPT}" \
  --vgg19_local "${VGG19_LOCAL}" \
  --img_h 768 \
  --img_w 1024 \
  --warmup 5 \
  --iters 30 \
  --per_bin 2 \
  --out_dir "${OUT_DIR}"
