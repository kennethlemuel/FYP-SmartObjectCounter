#!/bin/bash
#PBS -N eval_rgb_test
#PBS -P personal-kenneth0
#PBS -l select=1:ngpus=1:ncpus=8:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe

REPO=/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter
LOG_DIR=$REPO/logs
mkdir -p "$LOG_DIR"
cd "$REPO" || exit 1

module purge
module load pytorch/2.6.0-py3-cu11.8
export PYTHONPATH="$REPO:$PYTHONPATH"

exec > "$LOG_DIR/${PBS_JOBNAME}_${PBS_JOBID}.log" 2>&1

python -u scripts/eval_rgbt.py \
  --mode rgb \
  --data_root ./data/RGBT-CC-CVPR2021 \
  --split test \
  --ckpt outputs/rgb_e100_count_ema/ckpt_best.pt \
  --use_ema \
  --img_h 768 \
  --img_w 1024 \
  --sigma 15.0 \
  --out_stride 8 \
  --num_workers 4
