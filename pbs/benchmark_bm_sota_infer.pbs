#!/bin/bash
#PBS -N benchmark_bm_sota_infer
#PBS -P personal-kenneth0
#PBS -l select=1:ngpus=1:ncpus=8:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail
umask 0022

REPO_DEFAULT="/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter"
REPO="${REPO_DEFAULT}"
if [ -n "${PBS_O_WORKDIR:-}" ] && [ -f "${PBS_O_WORKDIR}/scripts/benchmark_bm_sota.py" ]; then
  REPO="${PBS_O_WORKDIR}"
fi

LOG_DIR="${REPO}/logs/benchmark_bm_sota"
OUT_DIR_ROOT="${REPO}/outputs/benchmark_bm_sota"
WEIGHTS_DIR="${REPO}/weights/broker_modality"
THIRD_PARTY_ROOT="${REPO}/third_party/Broker-Modality-Crowd-Counting"

: "${PBS_JOBID:=manual}"
: "${PBS_JOBNAME:=benchmark_bm_sota_infer}"

TS="$(date +%Y%m%d_%H%M%S)"
LOG_FILE="${LOG_DIR}/${PBS_JOBNAME}_${PBS_JOBID}_${TS}.log"
OUT_DIR="${OUT_DIR_ROOT}/${PBS_JOBID}_${TS}"

mkdir -p "${LOG_DIR}" "${OUT_DIR}" "${WEIGHTS_DIR}" "${REPO}/.torch/hub/checkpoints"
cd "${REPO}"

exec > "${LOG_FILE}" 2>&1
echo "[log] ${LOG_FILE}"
echo "[job] name=${PBS_JOBNAME} id=${PBS_JOBID} host=$(hostname) time=$(date)"
echo "[repo] ${REPO}"
echo "[third_party] ${THIRD_PARTY_ROOT}"

module purge
module load pytorch/2.6.0-py3-cu11.8

if [ -n "${BM_VENV:-}" ] && [ -f "${BM_VENV}/bin/activate" ]; then
  source "${BM_VENV}/bin/activate"
  echo "[venv] ${BM_VENV}"
else
  echo "[venv] NONE"
fi

export TORCH_HOME="${REPO}/.torch"
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO}:${PYTHONPATH:-}"

python3 - <<'PY'
import importlib
mods = ["torch", "timm", "numpy", "PIL"]
for m in mods:
    mod = importlib.import_module(m)
    print(m, getattr(mod, "__version__", "n/a"))
PY

nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader

VGG19_LOCAL="${VGG19_LOCAL:-${WEIGHTS_DIR}/vgg19-dcbb9e9d.pth}"
BM_CKPT="${BM_CKPT:-${WEIGHTS_DIR}/released_finetuned_model.ckpt}"
IMG_H="${IMG_H:-768}"
IMG_W="${IMG_W:-1024}"
BATCH_SIZE="${BATCH_SIZE:-1}"
WARMUP="${WARMUP:-20}"
ITERS="${ITERS:-100}"

if [ ! -f "${VGG19_LOCAL}" ]; then
  echo "[error] missing VGG19 backbone: ${VGG19_LOCAL}"
  exit 2
fi

CKPT_ARGS=()
if [ -f "${BM_CKPT}" ]; then
  echo "[ckpt] ${BM_CKPT}"
  CKPT_ARGS+=(--ckpt "${BM_CKPT}")
else
  echo "[ckpt] NONE"
fi

echo "[run] fp32 synthetic"
python3 -u scripts/benchmark_bm_sota.py \
  --repo_root "${REPO}" \
  --third_party_root "${THIRD_PARTY_ROOT}" \
  --vgg19_local "${VGG19_LOCAL}" \
  --h "${IMG_H}" \
  --w "${IMG_W}" \
  --batch_size "${BATCH_SIZE}" \
  --warmup "${WARMUP}" \
  --iters "${ITERS}" \
  --json_out "${OUT_DIR}/bm_fp32.json" \
  "${CKPT_ARGS[@]}"

echo "[run] amp synthetic"
python3 -u scripts/benchmark_bm_sota.py \
  --repo_root "${REPO}" \
  --third_party_root "${THIRD_PARTY_ROOT}" \
  --vgg19_local "${VGG19_LOCAL}" \
  --h "${IMG_H}" \
  --w "${IMG_W}" \
  --batch_size "${BATCH_SIZE}" \
  --warmup "${WARMUP}" \
  --iters "${ITERS}" \
  --amp \
  --json_out "${OUT_DIR}/bm_amp.json" \
  "${CKPT_ARGS[@]}"
