#!/bin/bash
#PBS -N eval_t_test
#PBS -P personal-kenneth0
#PBS -l select=1:ncpus=8:ngpus=1:mem=24gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"

REPO="/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter"
DATA_ROOT="$REPO/data/RGBT-CC-CVPR2021"
CKPT="$REPO/outputs/t_e100_count_ema/ckpt_best.pt"

LOG_DIR="$REPO/logs/eval"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/eval_t_test_${PBS_JOBID}_$(date +%Y%m%d_%H%M%S).log"
exec > >(tee -a "$LOG") 2>&1

echo "[job] name=eval_t_test id=${PBS_JOBID:-unknown} host=$(hostname) time=$(date)"

module purge
module load python/pytorch/2.6.0

export PYTHONPATH="$REPO:$PYTHONPATH"
export OMP_NUM_THREADS=8

python -V
python -c "import torch; print('torch:', torch.__version__, 'cuda:', torch.version.cuda, 'cuda_available:', torch.cuda.is_available())" || true
nvidia-smi || true

if [ ! -d "$DATA_ROOT" ]; then
  echo "[error] DATA_ROOT not found: $DATA_ROOT"
  exit 2
fi
if [ ! -f "$CKPT" ]; then
  echo "[error] CKPT not found: $CKPT"
  exit 2
fi

python -u "$REPO/scripts/eval_rgbt.py" \
  --mode t \
  --data_root "$DATA_ROOT" \
  --split test \
  --ckpt "$CKPT" \
  --img_h 768 --img_w 1024 \
  --sigma 15 --downsample 8 \
  --use_ema


echo "[done] $(date)"
