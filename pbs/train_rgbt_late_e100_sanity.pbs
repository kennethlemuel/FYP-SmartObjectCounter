#!/bin/bash
#PBS -N train_rgbt_late_e100
#PBS -P personal-kenneth0
#PBS -l select=1:ngpus=1:ncpus=16:mem=110gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/kenneth0/FYP-SmartObjectCounter/logs/train_rgbt_late_e100.out
#PBS -e /scratch/users/ntu/kenneth0/FYP-SmartObjectCounter/logs/train_rgbt_late_e100.err

REPO=/scratch/users/ntu/kenneth0/FYP-SmartObjectCounter
cd "$REPO" || exit 1

module purge
module load pytorch/2.6.0-py3-cu11.8

export PYTHONPATH="$REPO:$PYTHONPATH"

python -u scripts/train_rgbt.py \
  --mode late \
  --data_root ./data/RGBT-CC-CVPR2021 \
  --split_train train \
  --split_val val \
  --epochs 100 \
  --batch_size 1 \
  --grad_accum 1 \
  --lr 1e-5 \
  --optimizer adam \
  --weight_decay 1e-4 \
  --crop_size 224 \
  --flip_prob 0.5 \
  --scheduler multistep \
  --milestones 60,80 \
  --gamma 0.1 \
  --img_h 768 \
  --img_w 1024 \
  --sigma 15.0 \
  --out_stride 8 \
  --num_workers 4 \
  --amp \
  --save_dir outputs/rgbt_late_e100_sanity

