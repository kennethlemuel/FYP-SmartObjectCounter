#!/bin/bash
#PBS -N eval_rgb_e30
#PBS -P personal-kenneth0
#PBS -l select=1:ngpus=1:ncpus=8:mem=32gb
#PBS -l walltime=00:10:00
#PBS -j oe


cd "$PBS_O_WORKDIR" || exit 1

module purge
module load pytorch/2.6.0-py3-cu11.8

python scripts/eval_rgb_cc.py \
  --data_root ./data/RGBT-CC-CVPR2021 \
  --ckpt outputs/rgb_cc_e30/best_rgb.pth \
  --split val \
  --save_dir outputs/rgb_cc_test
